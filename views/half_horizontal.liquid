{% assign short_id = id | slice: 0, 8 %}

<style>
  .fact-half-horizontal {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 18px;
    align-items: stretch;
    box-sizing: border-box;
  }

  .fact-hh-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 4px solid #000;
    border-radius: 18px;
    padding: 22px 26px;
    box-sizing: border-box;
    box-shadow: 8px 8px 0 #000;
  }

  .fact-hh-label {
    align-self: flex-start;
    margin-bottom: 14px;
    padding: 4px 9px;
    background: #000;
    color: #fff;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .fact-hh-text {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.13;
  }

  .fact-hh-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-left: 3px solid #000;
    padding-left: 18px;
    box-sizing: border-box;
  }

  .fact-hh-kicker {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .fact-hh-meta-label {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .fact-hh-meta-value {
    display: block;
    font-size: 16px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .title-bar-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .title-bar-icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    filter: drop-shadow(1px 0 0 #fff) drop-shadow(-1px 0 0 #fff) drop-shadow(0 1px 0 #fff) drop-shadow(0 -1px 0 #fff);
  }
</style>

<div class="layout">
  <div class="fact-half-horizontal">
    <div class="fact-hh-card">
      <div class="fact-hh-label">Fact</div>
      <div class="fact-hh-text">{{ text }}</div>
    </div>

    <div class="fact-hh-side">
      <div>
        <div class="fact-hh-kicker">Useless Fact</div>
      </div>

      <div>
        <span class="fact-hh-meta-label">Source</span>
        <span class="fact-hh-meta-value">{{ source }}</span>
      </div>

      <div>
        <span class="fact-hh-meta-label">Fact ID</span>
        <span class="fact-hh-meta-value">{{ short_id }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
    <span class="title title-bar-brand">
      <svg class="title-bar-icon" viewBox="0 0 32 32" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="7" width="24" height="20" rx="3.5" fill="none" stroke="currentColor" stroke-width="2.6"/>
        <path d="M8 13H17M8 17H15M8 21H16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        <text x="22" y="23" fill="currentColor" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="900" text-anchor="middle">?</text>
        <g fill="currentColor">
          <path d="M20 5.5H23V11.5H20C18.6 11.5 17.5 10.4 17.5 9V8C17.5 6.6 18.6 5.5 20 5.5Z"/>
          <path d="M23 5.7L29 3.5V13.5L23 11.3V5.7Z"/>
          <rect x="19.5" y="11" width="2.8" height="6.2" rx="1.4" transform="rotate(-14 19.5 11)"/>
        </g>
      </svg>
      <span>Useless Facts</span>
    </span>
    <span class="instance">DanielPittsDev</span>
</div>
