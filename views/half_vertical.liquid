{% assign fact_length = text | size %}
{% if fact_length > 170 %}
  {% assign fact_text_class = "text--small font--bold" %}
  {% assign fact_card_padding_class = "p--4" %}
  {% assign fact_clamp = "8" %}
{% elsif fact_length > 120 %}
  {% assign fact_text_class = "text--base font--bold" %}
  {% assign fact_card_padding_class = "p--5" %}
  {% assign fact_clamp = "7" %}
{% elsif fact_length > 80 %}
  {% assign fact_text_class = "text--large font--bold" %}
  {% assign fact_card_padding_class = "p--5" %}
  {% assign fact_clamp = "6" %}
{% else %}
  {% assign fact_text_class = "text--xlarge font--bold" %}
  {% assign fact_card_padding_class = "p--6" %}
  {% assign fact_clamp = "5" %}
{% endif %}

<style>
  .fact-layout { height: calc(100% - 58px); box-sizing: border-box; }
  .fact-card-frame { border: 4px solid #000; box-shadow: 7px 7px 0 #000; min-height: 0; overflow: hidden; }
  .title-bar-icon { filter: drop-shadow(1px 0 0 #fff) drop-shadow(-1px 0 0 #fff) drop-shadow(0 1px 0 #fff) drop-shadow(0 -1px 0 #fff); }
</style>

<div class="layout fact-layout">
  <div class="flex flex--col gap h--full">
    <div class="border--h-1 pb--2 no-shrink flex flex--col flex--left w--full">
      <div class="title title--small text--left self--start w--full">USELESS FACT</div>
    </div>

    <div class="fact-card-frame rounded--large {{ fact_card_padding_class }} w--full grow flex flex--col flex--center-y">
      <div class="label mb--medium">Unnecessary knowledge</div>
      <div class="{{ fact_text_class }}" data-clamp="{{ fact_clamp }}">{{ text }}</div>
    </div>

    <div class="h--0.5 no-shrink"></div>

    <div class="grid grid--cols-2 gap--small no-shrink">
      <div class="outline rounded p--1">
        <div class="label label--small">Source</div>
        <div class="description" data-clamp="1">{{ source }}</div>
      </div>
      <div class="outline rounded p--1">
        <div class="label label--small">Source URL</div>
        <div class="description" data-clamp="1">{{ source_url }}</div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
    <span class="title text--left inline-flex flex--row flex--center-y gap--small">
      <svg class="title-bar-icon" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="7" width="24" height="20" rx="3.5" fill="none" stroke="currentColor" stroke-width="2.6"/>
        <path d="M8 13H17M8 17H15M8 21H16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        <text x="22" y="23" fill="currentColor" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="900" text-anchor="middle">?</text>
        <g fill="currentColor">
          <path d="M20 5.5H23V11.5H20C18.6 11.5 17.5 10.4 17.5 9V8C17.5 6.6 18.6 5.5 20 5.5Z"/>
          <path d="M23 5.7L29 3.5V13.5L23 11.3V5.7Z"/>
          <rect x="19.5" y="11" width="2.8" height="6.2" rx="1.4" transform="rotate(-14 19.5 11)"/>
        </g>
      </svg>
      <span>Useless Facts</span>
    </span>
    <span class="instance">DanielPittsDev</span>
</div>
