{% assign short_id = id | slice: 0, 8 %}

<style>
  .fact-half-vertical {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
  }

  .fact-hv-header {
    border-bottom: 3px solid #000;
    padding-bottom: 10px;
  }

  .fact-hv-kicker {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .fact-hv-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 4px solid #000;
    border-radius: 18px;
    padding: 22px;
    box-sizing: border-box;
    box-shadow: 7px 7px 0 #000;
  }

  .fact-hv-label {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .fact-hv-text {
    font-size: 25px;
    font-weight: 800;
    line-height: 1.14;
  }

  .fact-hv-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .fact-hv-meta-item {
    border: 2px solid #000;
    border-radius: 10px;
    padding: 8px 10px;
    box-sizing: border-box;
  }

  .fact-hv-meta-label {
    display: block;
    margin-bottom: 3px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .fact-hv-meta-value {
    display: block;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<div class="layout">
  <div class="fact-half-vertical">
    <div class="fact-hv-header">
      <div class="fact-hv-kicker">Useless Fact</div>
    </div>

    <div class="fact-hv-card">
      <div class="fact-hv-label">Unnecessary knowledge</div>
      <div class="fact-hv-text">{{ text }}</div>
    </div>

    <div class="fact-hv-meta">
      <div class="fact-hv-meta-item">
        <span class="fact-hv-meta-label">Source</span>
        <span class="fact-hv-meta-value">{{ source }}</span>
      </div>
      <div class="fact-hv-meta-item">
        <span class="fact-hv-meta-label">ID</span>
        <span class="fact-hv-meta-value">{{ short_id }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
    <span class="title">Useless Facts</span>
    <span class="instance">DanielPittsDev</span>
</div>
