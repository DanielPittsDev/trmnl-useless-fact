<style>
  .fact-quadrant {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 3px solid #000;
    border-radius: 16px;
    padding: 18px;
    box-sizing: border-box;
  }

  .fact-q-kicker {
    display: inline-block;
    margin-bottom: 12px;
    padding: 4px 8px;
    background: #000;
    color: #fff;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .fact-q-text {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.12;
  }

  .fact-q-source {
    padding-top: 10px;
    border-top: 2px solid #000;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<div class="layout">
  <div class="fact-quadrant">
    <div>
      <div class="fact-q-kicker">Fact</div>
      <div class="fact-q-text">{{ text }}</div>
    </div>

    <div class="fact-q-source">Source: {{ source }}</div>
  </div>
</div>

<div class="title_bar">
    <span class="title">Useless Facts</span>
    <span class="instance">DanielPittsDev</span>
</div>
