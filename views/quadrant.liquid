<style>
  .fact-quadrant {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 3px solid #000;
    border-radius: 16px;
    padding: 18px;
    box-sizing: border-box;
  }

  .fact-q-kicker {
    display: inline-block;
    margin-bottom: 12px;
    padding: 4px 8px;
    background: #000;
    color: #fff;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .fact-q-text {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.12;
  }

  .fact-q-source {
    padding-top: 10px;
    border-top: 2px solid #000;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .title-bar-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .title-bar-icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    filter: drop-shadow(1px 0 0 #fff) drop-shadow(-1px 0 0 #fff) drop-shadow(0 1px 0 #fff) drop-shadow(0 -1px 0 #fff);
  }
</style>

<div class="layout">
  <div class="fact-quadrant">
    <div>
      <div class="fact-q-kicker">Fact</div>
      <div class="fact-q-text">{{ text }}</div>
    </div>

    <div class="fact-q-source">Source: {{ source }}</div>
  </div>
</div>

<div class="title_bar">
    <span class="title title-bar-brand">
      <svg class="title-bar-icon" viewBox="0 0 32 32" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="7" width="24" height="20" rx="3.5" fill="none" stroke="currentColor" stroke-width="2.6"/>
        <path d="M8 13H17M8 17H15M8 21H16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        <text x="22" y="23" fill="currentColor" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="900" text-anchor="middle">?</text>
        <g fill="currentColor">
          <path d="M20 5.5H23V11.5H20C18.6 11.5 17.5 10.4 17.5 9V8C17.5 6.6 18.6 5.5 20 5.5Z"/>
          <path d="M23 5.7L29 3.5V13.5L23 11.3V5.7Z"/>
          <rect x="19.5" y="11" width="2.8" height="6.2" rx="1.4" transform="rotate(-14 19.5 11)"/>
        </g>
      </svg>
      <span>Useless Facts</span>
    </span>
    <span class="instance">DanielPittsDev</span>
</div>
