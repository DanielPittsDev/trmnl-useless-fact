{% assign fact_length = text | size %}
{% if fact_length > 120 %}
  {% assign fact_text_class = "text--small font--bold" %}
  {% assign fact_clamp = "8" %}
{% elsif fact_length > 85 %}
  {% assign fact_text_class = "text--small font--bold" %}
  {% assign fact_clamp = "7" %}
{% elsif fact_length > 55 %}
  {% assign fact_text_class = "text--base font--bold" %}
  {% assign fact_clamp = "6" %}
{% else %}
  {% assign fact_text_class = "text--large font--bold" %}
  {% assign fact_clamp = "5" %}
{% endif %}

<div class="layout" style="height: calc(100% - 58px); box-sizing: border-box;">
  <div class="rounded--large p--4 h--full flex flex--col gap--distribute" style="border: 3px solid #000; min-height: 0; overflow: hidden;">
    <div>
      <div class="label label--filled text--white text--left self--start mb--2">Fact</div>
      <div class="{{ fact_text_class }}" data-clamp="{{ fact_clamp }}">{{ text }}</div>
    </div>

    <div class="border--h-1 pt--2 no-shrink">
      <span class="description" data-clamp="1">Source: {{ source }}</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Useless Facts</span>
  <span class="instance">DanielPittsDev</span>
</div>
