{% assign fact_length = text | size %}
{% if fact_length > 230 %}
  {% assign fact_text_class = "text--large font--bold" %}
  {% assign fact_card_padding_class = "p--5" %}
  {% assign fact_label_margin_class = "mb--2" %}
  {% assign fact_clamp = "7" %}
{% elsif fact_length > 170 %}
  {% assign fact_text_class = "text--xlarge font--bold" %}
  {% assign fact_card_padding_class = "p--6" %}
  {% assign fact_label_margin_class = "mb--4" %}
  {% assign fact_clamp = "6" %}
{% elsif fact_length > 110 %}
  {% assign fact_text_class = "title title--large" %}
  {% assign fact_card_padding_class = "p--7" %}
  {% assign fact_label_margin_class = "mb--6" %}
  {% assign fact_clamp = "5" %}
{% else %}
  {% assign fact_text_class = "value" %}
  {% assign fact_card_padding_class = "p--8" %}
  {% assign fact_label_margin_class = "mb--6" %}
  {% assign fact_clamp = "4" %}
{% endif %}

<div class="layout" style="height: calc(100% - 58px); box-sizing: border-box;">
  <div class="flex flex--col gap h--full">
    <div class="border--h-1 pt--1 pl--2 pb--3 no-shrink flex flex--col flex--left w--full">
      <div class="title text--left self--start w--full">USELESS FACT</div>
      <div class="description description--large text--left self--start w--full">Random dispatch from the archive</div>
    </div>

    <div class="rounded--xlarge {{ fact_card_padding_class }} w--full grow flex flex--col flex--center-y" style="border: 4px solid #000; box-shadow: 10px 10px 0 #000; min-height: 0; overflow: hidden;">
      <div class="label label--filled text--white text--left self--start {{ fact_label_margin_class }}">TODAY'S UNNECESSARY KNOWLEDGE</div>
      <div class="{{ fact_text_class }}" data-clamp="{{ fact_clamp }}">&ldquo;{{ text }}&rdquo;</div>
    </div>

    <div class="h--0.5 no-shrink"></div>

    <div class="grid grid--cols-2 gap--small no-shrink">
      <div class="outline rounded p--2">
        <div class="label label--small">Source</div>
        <div class="description description--large" data-clamp="1">{{ source }}</div>
      </div>
      <div class="outline rounded p--2">
        <div class="label label--small">Source URL</div>
        <div class="description description--large" data-clamp="1">{{ source_url }}</div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Useless Facts</span>
  <span class="instance">DanielPittsDev</span>
</div>
